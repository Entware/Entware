#!/bin/sh /etc/rc.common
# Copyright (c) 2014 OpenWrt.org

START=11

USE_PROCD=1
PROG=/opt/sbin/auditd

start_service() {
	mkdir -p /opt/var/log/audit
	procd_open_instance
	procd_set_param command "$PROG" -n
	procd_set_param respawn
	procd_close_instance
	test -f /opt/etc/audit/rules.d/audit.rules && /opt/sbin/auditctl -R /opt/etc/audit/rules.d/audit.rules
}
